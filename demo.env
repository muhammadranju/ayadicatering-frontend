// for nextjs project
module.exports = {
  apps: [
    {
      name: "ayadicatering-frontend",
      script: "node_modules/next/dist/bin/next",
      args: "start",
      env: {
        NODE_ENV: "production",
        PORT: 3000
      },
    },
  ],
};
// for modular nodejs project
module.exports = {
    apps: [
        {
            name: 'ayadicatering-backend',
            script: './dist/server.js',
            args: 'start',
            env: {
                NODE_ENV: 'production',
                 PORT: 5000
            },
        },
    ],
};